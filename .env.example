# Production URL used in canonical tags, sitemap.xml, RSS, and structured data.
SITE_URL=https://oracle-university.com

# Recommended provider mode. "auto" uses every configured provider with a key, plus official RSS.
NEWS_PROVIDER=auto
MAX_ARTICLES=120

# Free / freemium providers. Keep these as CI/CD secrets, never in browser code.
NEWSDATA_API_KEY=your_newsdata_key
FREENEWSAPI_KEY=your_freenewsapi_key
GNEWS_API_KEY=your_gnews_key
NEWSAPI_KEY=your_newsapi_key_for_development_only

# Optional provider controls.
ENABLE_OFFICIAL_RSS=1
FREENEWSAPI_FETCH_DETAILS=1
SAMPLE_ONLY=0
